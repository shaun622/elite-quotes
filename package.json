{
  "name": "elite-quotes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply elite-walls --local",
    "db:migrate:remote": "wrangler d1 migrations apply elite-walls --remote",
    "db:studio": "drizzle-kit studio",
    "deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.4",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.1.13",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "resend": "^4.0.1",
    "ulid": "^2.3.0",
    "zod": "^4.0.0"
  }
}
